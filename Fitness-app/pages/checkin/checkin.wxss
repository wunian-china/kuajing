.section-title {
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 24rpx;
}

.type-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.type-item {
  width: 31%;
  border-radius: 20rpx;
  padding: 24rpx 0;
  text-align: center;
  margin-bottom: 18rpx;
  background: #F8FAFC;
  border: 3rpx solid transparent;
  box-sizing: border-box;
}

.type-item.active {
  background: #F0FDF4;
  border-color: #22C55E;
}

.type-icon {
  font-size: 56rpx;
}

.type-name {
  font-size: 26rpx;
  color: #374151;
  margin-top: 8rpx;
}

.duration-row {
  display: flex;
  align-items: baseline;
  margin-bottom: 16rpx;
}

.duration-num {
  font-size: 80rpx;
  font-weight: 800;
  color: #22C55E;
  line-height: 1;
}

.duration-unit {
  font-size: 28rpx;
  color: #6B7280;
  margin-left: 10rpx;
}

.note-input {
  width: 100%;
  height: 160rpx;
  background: #F8FAFC;
  border-radius: 16rpx;
  padding: 20rpx;
  box-sizing: border-box;
  font-size: 28rpx;
}

.submit-btn {
  margin-top: 40rpx;
}