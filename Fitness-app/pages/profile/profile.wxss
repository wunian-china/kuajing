.profile-card {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #22C55E 0%, #0EA5E9 100%);
  border-radius: 28rpx;
  padding: 40rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 12rpx 32rpx rgba(34, 197, 94, 0.24);
}

.avatar-lg {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
  font-weight: 700;
  color: #fff;
  margin-right: 28rpx;
}

.profile-info {
  color: #fff;
}

.nickname-input {
  font-size: 38rpx;
  font-weight: 700;
  color: #fff;
  height: 60rpx;
}

.slogan {
  font-size: 24rpx;
  opacity: 0.9;
  margin-top: 8rpx;
}

/* 统计 */
.stats {
  display: flex;
  align-items: center;
}

.stat {
  flex: 1;
  text-align: center;
}

.stat-num {
  font-size: 44rpx;
  font-weight: 800;
  color: #22C55E;
}

.stat-label {
  font-size: 24rpx;
  color: #9AA0A6;
  margin-top: 6rpx;
}

.stat-divider {
  width: 2rpx;
  height: 56rpx;
  background: #EEF0F2;
}

/* 功能入口 */
.menu-card {
  padding: 8rpx 28rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
}

.menu-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
}

.menu-text {
  font-size: 30rpx;
  font-weight: 600;
}

.menu-arrow {
  font-size: 36rpx;
}

/* 目标 */
.goal-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.goal-head .section-title {
  margin-bottom: 0;
}

.goal-value {
  font-size: 32rpx;
  font-weight: 700;
  color: #22C55E;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 20rpx;
}

/* 记录 */
.record {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #F3F4F6;
}

.record:last-child {
  border-bottom: none;
}

.record-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  background: #F0FDF4;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  margin-right: 20rpx;
}

.record-name {
  font-size: 30rpx;
  font-weight: 600;
}

.record-note {
  font-size: 24rpx;
  margin-top: 4rpx;
}

.record-min {
  font-size: 30rpx;
  font-weight: 700;
  color: #22C55E;
}

.empty {
  text-align: center;
  padding: 60rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.clear-btn {
  margin-top: 40rpx;
  background: #fff;
  color: #EF4444;
  border-radius: 999rpx;
  font-size: 28rpx;
}

.clear-btn::after {
  border: none;
}

.about {
  text-align: center;
  font-size: 24rpx;
  margin-top: 40rpx;
}