.team-banner {
  background: linear-gradient(135deg, #0EA5E9 0%, #22C55E 100%);
  border-radius: 28rpx;
  padding: 36rpx;
  color: #fff;
  margin-bottom: 24rpx;
  box-shadow: 0 12rpx 32rpx rgba(14, 165, 233, 0.25);
}

.team-name {
  font-size: 40rpx;
  font-weight: 800;
}

.team-sub {
  font-size: 26rpx;
  opacity: 0.9;
  margin-top: 8rpx;
}

.team-today {
  margin-top: 20rpx;
  font-size: 28rpx;
}

.hl {
  font-size: 40rpx;
  font-weight: 800;
}

.invite-code-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.invite-label {
  font-size: 24rpx;
  color: #9AA0A6;
}

.invite-code {
  font-size: 56rpx;
  font-weight: 800;
  letter-spacing: 8rpx;
  color: #1F2937;
}

.invite-actions {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.mini-btn {
  margin: 0;
}

.mini-btn.ghost {
  background: #fff;
  color: #0EA5E9;
  border: 2rpx solid #0EA5E9;
  border-radius: 999rpx;
}

.invite-btns {
  display: flex;
  gap: 20rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  margin: 28rpx 4rpx 18rpx;
}

.member {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 2rpx solid #F3F4F6;
}

.member:last-child {
  border-bottom: none;
}

.member-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #F1F5F9;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  font-weight: 700;
  margin-right: 20rpx;
  color: #6B7280;
}

.member-avatar.done {
  background: #DCFCE7;
  color: #16A34A;
}

.member-name {
  font-size: 30rpx;
  font-weight: 600;
}

.me-tag {
  font-size: 20rpx;
  background: #E0F2FE;
  color: #0284C7;
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
  margin-left: 10rpx;
}

.member-sub {
  font-size: 24rpx;
  margin-top: 4rpx;
}

.member-right {
  text-align: right;
}

.member-min {
  font-size: 28rpx;
  font-weight: 700;
  color: #1F2937;
}

.member-status {
  font-size: 22rpx;
  margin-top: 6rpx;
}

.member-status.ok {
  color: #22C55E;
}

.member-status.no {
  color: #F59E0B;
}

.tip {
  text-align: center;
  font-size: 24rpx;
  margin-top: 24rpx;
}

/* 弹窗 */
.mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.dialog {
  width: 600rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx;
}

.dialog-title {
  font-size: 34rpx;
  font-weight: 700;
  text-align: center;
  margin-bottom: 30rpx;
}

.join-input {
  background: #F8FAFC;
  border-radius: 16rpx;
  height: 88rpx;
  padding: 0 24rpx;
  font-size: 34rpx;
  letter-spacing: 6rpx;
  text-align: center;
  margin-bottom: 30rpx;
}

.dialog-btns {
  display: flex;
  gap: 20rpx;
}

/* 空状态：尚未加入战队 */
.empty-team {
  margin-top: 40rpx;
  padding: 70rpx 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.empty-team-icon {
  font-size: 110rpx;
  line-height: 1;
  margin-bottom: 26rpx;
}

.empty-team-title {
  font-size: 38rpx;
  font-weight: 600;
  color: #1F2937;
  margin-bottom: 16rpx;
}

.empty-team-sub {
  font-size: 27rpx;
  color: #9CA3AF;
  line-height: 1.6;
  margin-bottom: 40rpx;
}

.empty-team-btn {
  width: 100%;
  margin-bottom: 20rpx;
}